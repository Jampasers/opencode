{
  "$schema": "https://opencode.ai/config.json",
  "model": "guwehj",
  "plugin": [
    "@vheins/opencode-9router@0.9.1",
    "@upstash/context7-opencode",
    "@plannotator/opencode@0.28.30",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "provider": {
    "9router-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DankaStur 9Router",
      "options": {
        "baseURL": "https://ai.dankastur.com/v1",
        "apiKey": "{env:ROUTER_API_KEY}",
        "cache": true,
        "discoveryTimeout": 60000
      }
    }
  },
  "permission": {
    "edit": "allow",
    // Rule terakhir yang match menang: rule sempit harus di paling bawah.
    "bash": {
      "*": "allow",
      "Remove-Item *": "ask",
      "rm *": "ask",
      "git push --force*": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      "pnpm publish*": "ask",
      "npm publish*": "ask",
      "gh repo delete*": "deny",
      "rm -rf*": "deny"
    },
    "external_directory": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/gcloud/**": "deny"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@playwright/mcp@0.0.83", "--headless"],
      "enabled": true
    }
  }
}
