
{
  "$schema": "https://opencode.ai/config.json",
  "model": "guwehj",
  "plugin": [
    "@vheins/opencode-9router@0.9.1"
  ],
  "provider": {
    "9router-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DankaStur 9Router",
      "options": {
        "baseURL": "https://ai.dankastur.com/v1",
        "apiKey": "{env:ROUTER_API_KEY}",
        "cache": true,
        "discoveryTimeout": 60000
      }
    }
  }
}
